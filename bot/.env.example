# ── Яндекс.Билеты (те же данные, что вводятся в приложении Envo) ──
YANDEX_LOGIN=
YANDEX_PASSWORD=
YANDEX_CITY_ID=

# ── Microsoft 365 / Graph API (см. README, раздел «Настройка Microsoft 365») ──
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
# Ящик, от имени которого отправляются письма, например tickets@вашдомен.ru
MAIL_FROM=

# ── Админка ──
# Придумай длинный случайный токен: openssl rand -hex 24
ADMIN_TOKEN=

# ── Необязательные настройки ──
# Интервал опроса API, секунды (по умолчанию 60)
#POLL_INTERVAL_SEC=60
# За сколько дней назад запрашивать заказы (по умолчанию 7)
#LOOKBACK_DAYS=7
# Режим проверки: письма не отправляются, только пишутся в лог
#DRY_RUN=1
